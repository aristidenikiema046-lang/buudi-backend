# Copier vers .env sur le serveur puis compléter les valeurs manquantes.

APP_NAME=Buudi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.buudi.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base PostgreSQL native partagee du VPS (creee via psql, une base dediee a Buudi).
# Les conteneurs tournent en network_mode: host, donc 127.0.0.1 = l'hote directement.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buudi
DB_USERNAME=buudi_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=

FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# Distance Matrix API activée (distinct de Directions API, côté Flutter) — sert
# au calcul serveur du prix des courses VTC.
GOOGLE_MAPS_API_KEY=

# Fournisseurs de paiement mobile money (voir config/services.php) — placeholders
# tant qu'aucune integration reelle n'a demarre.
WAVE_API_KEY=
WAVE_BASE_URL=
WAVE_WEBHOOK_SECRET=

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_WEBHOOK_SECRET=

MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=
MTN_MOMO_WEBHOOK_SECRET=

MOOV_MONEY_API_KEY=
MOOV_MONEY_BASE_URL=
MOOV_MONEY_WEBHOOK_SECRET=

DEXCHANGE_API_KEY=
DEXCHANGE_BASE_URL=
DEXCHANGE_WEBHOOK_SECRET=
