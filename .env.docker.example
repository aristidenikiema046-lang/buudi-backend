# Copier vers .env sur le serveur puis compléter les valeurs manquantes.

APP_NAME=Buudi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.buudi.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base PostgreSQL native partagee du VPS (creee via ISPConfig, une base dediee a Buudi)
DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5432
DB_DATABASE=buudi
DB_USERNAME=buudi_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=

FIREBASE_CREDENTIALS=/var/www/html/storage/app/firebase-credentials.json

# Port hote local (derriere le ProxyPass ISPConfig du vhost Buudi) - verifier avec ss -tlnp avant de choisir
APP_HOST_PORT=8090
